def test_chunk_ids_stay_stable_when_content_changes(tmp_path):
    class CaptureIndexer:
        def __init__(self):
            self.chunks = []
            self.expected_ids = None

        def upsert(self, chunks):
            self.chunks = list(chunks)
            return len(chunks)

        def reconcile_source(self, source_id, expected_chunk_ids):
            self.expected_ids = expected_chunk_ids
            return 0

    source = tmp_path / "device.md"
    source.write_text(
        "Device ORBITAL-WRENCH-731 uses a 48 volt supply.",
        encoding="utf-8",
    )

    indexer = CaptureIndexer()
    pipeline = IngestionPipeline(indexer=indexer)

    first = pipeline.run(tmp_path, "forge", "stable-id-test")
    first_ids = {chunk.chunk_id for chunk in indexer.chunks}
    first_hash = indexer.chunks[0].content_hash

    source.write_text(
        "Device COBALT-FALCON-842 uses a 72 volt supply.",
        encoding="utf-8",
    )

    second = pipeline.run(tmp_path, "forge", "stable-id-test")
    second_ids = {chunk.chunk_id for chunk in indexer.chunks}

    assert first.complete and second.complete
    assert first_ids == second_ids
    assert indexer.chunks[0].content_hash != first_hash
    assert indexer.expected_ids == second_ids


def test_unsupported_file_creates_stub_and_allows_reconciliation(tmp_path):
    (tmp_path / "unsupported.unknown").write_bytes(b"unknown format")

    class TrackIndexer:
        def __init__(self):
            self.cleaned = False
            self.chunks = []

        def upsert(self, chunks):
            self.chunks = list(chunks)
            return len(self.chunks)

        def reconcile_source(self, source_id, expected_chunk_ids):
            self.cleaned = True
            return 0

    indexer = TrackIndexer()
    report = IngestionPipeline(indexer=indexer).run(
        tmp_path, "forge", "unsupported-test"
    )

    assert report.complete
    assert report.metadata_only == 1
    assert report.skipped == 0
    assert indexer.cleaned
    assert len(indexer.chunks) == 1
    assert indexer.chunks[0].payload()["record_type"] == "artifact_stub"

def test_unsupported_file_creates_metadata_stub(tmp_path):
    (tmp_path / "assembly.stl").write_bytes(b"not parsed as geometry")

    class CaptureIndexer:
        def __init__(self):
            self.chunks = []
            self.reconciled = None

        def upsert(self, chunks):
            self.chunks = list(chunks)
            return len(self.chunks)

        def reconcile_source(self, source_id, expected_chunk_ids):
            self.reconciled = (source_id, expected_chunk_ids)
            return 0

    indexer = CaptureIndexer()
    report = IngestionPipeline(indexer=indexer).run(
        tmp_path, "forge", "stub-test"
    )

    assert report.complete
    assert report.metadata_only == 1
    assert report.extracted == 0
    assert len(indexer.chunks) == 1

    chunk = indexer.chunks[0]
    payload = chunk.payload()

    assert payload["record_type"] == "artifact_stub"
    assert payload["inferred_category"] == "3d_geometry"
    assert payload["content_inspected"] is False
    assert payload["artifact_status"] == "metadata_only"
    assert "assembly.stl" in chunk.text
    assert indexer.reconciled is not None


def test_failed_extraction_creates_stub_without_reconciliation(tmp_path):
    (tmp_path / "broken.json").write_text(
        "{ invalid json",
        encoding="utf-8",
    )

    class CaptureIndexer:
        def __init__(self):
            self.chunks = []
            self.reconciled = False

        def upsert(self, chunks):
            self.chunks = list(chunks)
            return len(self.chunks)

        def reconcile_source(self, source_id, expected_chunk_ids):
            self.reconciled = True
            return 0

    indexer = CaptureIndexer()
    report = IngestionPipeline(indexer=indexer).run(
        tmp_path, "forge", "broken-test"
    )

    assert not report.complete
    assert report.blocked == 1
    assert not indexer.reconciled
    assert any(
        chunk.payload().get("record_type") == "artifact_stub"
        for chunk in indexer.chunks
    )


