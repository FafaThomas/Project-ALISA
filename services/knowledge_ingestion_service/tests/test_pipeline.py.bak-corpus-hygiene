def test_faction_and_source_namespaces_are_attached(tmp_path):
    (tmp_path / "main.py").write_text("print('hello')", encoding="utf-8")
    class CaptureIndexer:
        def __init__(self): self.chunks = []; self.reconciled = None
        def upsert(self, chunks): self.chunks.extend(chunks); return len(chunks)
        def reconcile_source(self, source_id, seen): self.reconciled = (source_id, seen); return 0
    indexer = CaptureIndexer()
    report = IngestionPipeline(indexer=indexer).run(tmp_path, "forge", "test-source")
    assert report.collection_name == "alisa_faction_forge"
    assert report.source_id == "test-source"
    assert indexer.chunks[0].faction_id == "forge"
    assert indexer.chunks[0].source_id == "test-source"
    assert indexer.reconciled[0] == "test-source"
    assert indexer.reconciled[1] == {
        chunk.chunk_id for chunk in indexer.chunks
    }

