def test_extract_utf16le_text_with_bom(tmp_path):
    from src.knowledge_ingestion_service.extractors import extract

    source = tmp_path / "tree.txt"
    source.write_bytes(
        "Folder PATH listing\n├── src\n└── README.md\n".encode("utf-16")
    )

    text, extractor, media_type, metadata = extract(source)

    assert "Folder PATH listing" in text
    assert "README.md" in text
    assert "\x00" not in text
    assert extractor == "generic_text"


